# Adaptive LLM Routing - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================
# Groq API (Primary Provider)
# ============================================================
# Get free API keys at: https://console.groq.com
# Free tier: 14,400 requests/day per account

GROQ_API_1=your_groq_api_key_1_here
GROQ_API_2=your_groq_api_key_2_here

# ============================================================
# Mistral API (Multi-Agent Pipeline)
# ============================================================
# Get free API key at: https://console.mistral.ai
# Free tier: 1M tokens/month

MISTRAL_API=your_mistral_api_key_here

# ============================================================
# Google Gemini API (Evaluation/Judge)
# ============================================================
# Get free API key at: https://makersuite.google.com/app/apikey
# Free tier: 1,500 requests/day

GOOGLE_API=your_google_api_key_here

# ============================================================
# HuggingFace API (Fallback Provider)
# ============================================================
# Get free API key at: https://huggingface.co/settings/tokens
# Free tier: 1,000 requests/hour

HUGGINGFACE_API=your_huggingface_api_key_here

# ============================================================
# Notes
# ============================================================
# - At minimum, you need GROQ_API_1 to run experiments
# - For full functionality, provide all API keys
# - Multiple Groq accounts enable load balancing
# - Never commit the .env file to version control
